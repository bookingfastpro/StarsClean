{
  "entities": {
    "Property": {
      "title": "Property",
      "description": "A rental property managed by the conciergerie.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Name of the property" },
        "category": { "type": "string", "enum": ["studios", "minivillas", "villas"], "description": "Type of property" },
        "location": { "type": "string", "description": "Geographic location" },
        "capacity": { "type": "string", "description": "Number of people it can host" },
        "bathrooms": { "type": "number", "description": "Number of bathrooms" },
        "pmr": { "type": "boolean", "description": "Accessible for people with reduced mobility" },
        "beds": { "type": "number", "description": "Number of bedrooms/beds" },
        "desc": { "type": "string", "description": "Full description" },
        "images": { "type": "array", "items": { "type": "string" }, "description": "URLs of property images" },
        "features": { "type": "array", "items": { "type": "string" }, "description": "Key features/amenities" }
      },
      "required": ["title", "category", "location", "capacity", "desc"]
    },
    "User": {
      "title": "User",
      "description": "User profile with roles.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "client"] }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/properties": {
      "schema": "Property",
      "description": "Collection of all rental properties."
    },
    "/users": {
      "schema": "User",
      "description": "User roles and profiles."
    }
  }
}
