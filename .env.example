# SITE_URL: adresse publique définitive du site (balises canoniques, sitemap, robots.txt).
SITE_URL="https://conciergerie-corse-du-sud.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Identifiants du panneau de gestion des biens (/admin).
# ⚠️ Choisissez un mot de passe long et unique : celui par défaut est public.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Secret de signature des sessions (une longue chaîne aléatoire). Sans lui, les admins
# sont déconnectés à chaque redémarrage du serveur.
ADMIN_SESSION_SECRET=

# Supabase configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Recommandé : clé service_role (uniquement côté serveur, jamais dans le navigateur).
# Elle permet de fermer les politiques RLS publiques en écriture (voir SUPABASE_SETUP.md).
SUPABASE_SERVICE_ROLE_KEY=

# SMTP Configuration (Optional for contact form)
# For Gmail: use an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Star's Clean <conciergerie.prestige2a@gmail.com>"
